---
import type { CollectionEntry } from 'astro:content';
import { articleUrl, articleDate } from '../lib/articles';
interface Props { articles: CollectionEntry<'articles'>[] }
const { articles } = Astro.props;
---
{articles.length ? (
  <ul class="article-list">
    {articles.map(article => <li data-reveal><a class="article-row" href={articleUrl(article.id)} data-article-url={articleUrl(article.id)}>
      <time class="mono" datetime={articleDate(article.data.date)}>{articleDate(article.data.date)}</time>
      <div><h3 data-article-title={articleUrl(article.id)}>{article.data.title}</h3>{article.data.description && <p>{article.data.description}</p>}</div>
      <span aria-hidden="true">↗</span>
    </a></li>)}
  </ul>
) : (
  <p class="articles-empty" data-reveal>还没有文章，慢慢写。</p>
)}
