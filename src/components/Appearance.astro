---
const modes = [
  { value: 'light', label: '浅色', path: 'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { value: 'dark', label: '深色', path: 'M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z' },
  { value: 'system', label: '系统', path: 'M4 4h16v12H4zM8 20h8m-4-4v4' },
] as const;
const accents = [
  { value: 'blue', label: '蓝色', color: '#4568eb' },
  { value: 'green', label: '青绿', color: '#328b71' },
  { value: 'purple', label: '紫色', color: '#9467d9' },
  { value: 'pink', label: '樱粉', color: '#cb719a' },
];
---
<details class="appearance" id="appearance" transition:persist="appearance">
  <summary class="appearance-toggle" aria-label="外观设置" title="外观设置">
    <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><path d={modes[0].path} /></svg>
    <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d={modes[1].path} /></svg>
    <span class="appearance-dot" aria-hidden="true"></span>
  </summary>
  <div class="appearance-panel">
    <fieldset>
      <legend>外观</legend>
      <div class="mode-options">
        {modes.map(mode => <label class="mode-option">
          <input type="radio" name="color-mode" value={mode.value} checked={mode.value === 'system'} />
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={mode.path} /></svg>
          <span>{mode.label}</span>
        </label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend>主题色</legend>
      <div class="accent-options">
        {accents.map(accent => <label class="accent-option" style={`--swatch:${accent.color}`}>
          <input type="radio" name="accent" value={accent.value} checked={accent.value === 'blue'} />
          <span class="accent-swatch" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /></svg></span>
          <span>{accent.label}</span>
        </label>)}
      </div>
    </fieldset>
    <fieldset class="wallpaper-settings">
      <legend>背景</legend>
      <div class="wallpaper-options">
        <label class="wallpaper-option">
          <input type="radio" name="wallpaper" value="ink" checked />
          <span class="wallpaper-sample wallpaper-sample-ink" aria-hidden="true"></span>
          <span>黑白插画</span>
        </label>
        <label class="wallpaper-option">
          <input type="radio" name="wallpaper" value="glow" />
          <span class="wallpaper-sample wallpaper-sample-glow" aria-hidden="true"></span>
          <span>柔光渐变</span>
        </label>
        <label class="wallpaper-option">
          <input type="radio" name="wallpaper" value="none" />
          <span class="wallpaper-sample wallpaper-sample-none" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 18 18 6" /></svg></span>
          <span>关闭壁纸</span>
        </label>
      </div>
    </fieldset>
    <label class="sakura-option">
      <span class="sakura-option-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10C7 2 4 7 7 11c-8 0-6 6-1 6-2 6 4 7 6 2 2 5 8 4 6-2 5 0 7-6-1-6 3-4 0-9-5-1Z" /></svg>飘落樱花</span>
      <input type="checkbox" name="sakura" role="switch" />
      <span class="setting-switch" aria-hidden="true"></span>
    </label>
    <p class="motion-note">已跟随系统减少动态效果</p>
    <label class="sakura-option mascot-option">
      <span class="sakura-option-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4 4 8v7a8 8 0 0 0 16 0V8l-3-4-3 3h-4L7 4ZM8 12h.01M16 12h.01M10 16q2 2 4 0" /></svg>看板娘</span>
      <input type="checkbox" name="mascot" role="switch" />
      <span class="setting-switch" aria-hidden="true"></span>
    </label>
  </div>
</details>
<script>
  const root = document.documentElement;
  const picker = document.querySelector<HTMLDetailsElement>('#appearance')!;
  const toggle = picker.querySelector<HTMLElement>('summary')!;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const modeKey = 'buluku-color-mode';
  const accentKey = 'buluku-accent';
  const wallpaperKey = 'buluku-wallpaper';
  const sakuraKey = 'buluku-sakura';
  const mascotKey = 'buluku-mascot';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const validMode = (value: string | null | undefined) => ['light', 'dark', 'system'].includes(value ?? '') ? value! : 'system';
  const validAccent = (value: string | null | undefined) => ['blue', 'green', 'purple', 'pink'].includes(value ?? '') ? value! : 'blue';
  const validWallpaper = (value: string | null | undefined) => ['ink', 'glow', 'none'].includes(value ?? '') ? value! : 'ink';
  let mode = validMode(root.dataset.mode);
  let accent = validAccent(root.dataset.accent);
  let wallpaper = validWallpaper(root.dataset.wallpaper);
  let sakura = root.dataset.sakura === 'on';
  let mascot = root.dataset.mascot === 'on';

  function apply() {
    root.dataset.mode = mode;
    root.dataset.theme = mode === 'system' ? (system.matches ? 'dark' : 'light') : mode;
    root.dataset.accent = accent;
    root.dataset.wallpaper = wallpaper;
    root.dataset.sakura = sakura ? 'on' : 'off';
    root.dataset.mascot = mascot ? 'on' : 'off';
    picker.querySelectorAll<HTMLInputElement>('input').forEach(input => {
      if (input.name === 'color-mode') input.checked = input.value === mode;
      if (input.name === 'accent') input.checked = input.value === accent;
      if (input.name === 'wallpaper') input.checked = input.value === wallpaper;
      if (input.name === 'mascot') input.checked = mascot;
      if (input.name === 'sakura') {
        input.checked = sakura && !reducedMotion.matches;
        input.disabled = reducedMotion.matches;
      }
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', root.dataset.theme === 'dark' ? '#14161d' : '#fbfbfc');
    window.dispatchEvent(new Event('appearancechange'));
  }
  picker.addEventListener('change', event => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    if (input.name === 'color-mode') mode = validMode(input.value);
    if (input.name === 'accent') accent = validAccent(input.value);
    if (input.name === 'wallpaper') wallpaper = validWallpaper(input.value);
    if (input.name === 'sakura') sakura = input.checked;
    if (input.name === 'mascot') mascot = input.checked;
    apply();
    try {
      localStorage.setItem(modeKey, mode);
      localStorage.setItem(accentKey, accent);
      localStorage.setItem(wallpaperKey, wallpaper);
      localStorage.setItem(sakuraKey, sakura ? 'on' : 'off');
      localStorage.setItem(mascotKey, mascot ? 'on' : 'off');
    } catch { /* The controls still work when browser storage is unavailable. */ }
  });
  system.addEventListener('change', () => { if (mode === 'system') apply(); });
  reducedMotion.addEventListener('change', apply);
  document.addEventListener('astro:after-swap', () => { picker.open = false; apply(); });
  window.addEventListener('mascotchange', event => {
    if (!(event instanceof CustomEvent) || typeof event.detail !== 'boolean') return;
    mascot = event.detail;
    apply();
    try { localStorage.setItem(mascotKey, mascot ? 'on' : 'off'); } catch {}
  });
  window.addEventListener('storage', event => {
    if (event.key === modeKey || event.key === null) mode = validMode(event.newValue);
    if (event.key === accentKey || event.key === null) accent = validAccent(event.newValue);
    if (event.key === wallpaperKey || event.key === null) wallpaper = validWallpaper(event.newValue);
    if (event.key === sakuraKey || event.key === null) sakura = event.newValue === null ? !reducedMotion.matches : event.newValue === 'on';
    if (event.key === mascotKey || event.key === null) mascot = event.newValue !== 'off';
    if ([modeKey, accentKey, wallpaperKey, sakuraKey, mascotKey, null].includes(event.key)) apply();
  });
  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && picker.open) { picker.open = false; toggle.focus(); }
  });
  apply();
</script>
