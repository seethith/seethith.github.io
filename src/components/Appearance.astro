---
const modes = [
  { value: 'light', label: '浅色', path: 'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { value: 'dark', label: '深色', path: 'M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z' },
  { value: 'system', label: '系统', path: 'M4 4h16v12H4zM8 20h8m-4-4v4' },
] as const;
const accents = [
  { value: 'blue', label: '蓝色', color: '#4568eb' },
  { value: 'green', label: '青绿', color: '#328b71' },
  { value: 'purple', label: '紫色', color: '#9467d9' },
  { value: 'pink', label: '樱粉', color: '#cb719a' },
];
---
<details class="appearance" id="appearance">
  <summary class="appearance-toggle" aria-label="外观设置" title="外观设置">
    <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><path d={modes[0].path} /></svg>
    <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d={modes[1].path} /></svg>
    <span class="appearance-dot" aria-hidden="true"></span>
  </summary>
  <div class="appearance-panel">
    <fieldset>
      <legend>外观</legend>
      <div class="mode-options">
        {modes.map(mode => <label class="mode-option">
          <input type="radio" name="color-mode" value={mode.value} checked={mode.value === 'system'} />
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={mode.path} /></svg>
          <span>{mode.label}</span>
        </label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend>主题色</legend>
      <div class="accent-options">
        {accents.map(accent => <label class="accent-option" style={`--swatch:${accent.color}`}>
          <input type="radio" name="accent" value={accent.value} checked={accent.value === 'blue'} />
          <span class="accent-swatch" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /></svg></span>
          <span>{accent.label}</span>
        </label>)}
      </div>
    </fieldset>
  </div>
</details>
<script>
  const root = document.documentElement;
  const picker = document.querySelector<HTMLDetailsElement>('#appearance')!;
  const toggle = picker.querySelector<HTMLElement>('summary')!;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const modeKey = 'buluku-color-mode';
  const accentKey = 'buluku-accent';
  const validMode = (value: string | null | undefined) => ['light', 'dark', 'system'].includes(value ?? '') ? value! : 'system';
  const validAccent = (value: string | null | undefined) => ['blue', 'green', 'purple', 'pink'].includes(value ?? '') ? value! : 'blue';
  let mode = validMode(root.dataset.mode);
  let accent = validAccent(root.dataset.accent);

  function apply() {
    root.dataset.mode = mode;
    root.dataset.theme = mode === 'system' ? (system.matches ? 'dark' : 'light') : mode;
    root.dataset.accent = accent;
    picker.querySelectorAll<HTMLInputElement>('input').forEach(input => {
      input.checked = input.value === (input.name === 'color-mode' ? mode : accent);
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', root.dataset.theme === 'dark' ? '#14161d' : '#fbfbfc');
    window.dispatchEvent(new Event('appearancechange'));
  }
  picker.addEventListener('change', event => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    if (input.name === 'color-mode') mode = validMode(input.value);
    if (input.name === 'accent') accent = validAccent(input.value);
    apply();
    try {
      localStorage.setItem(modeKey, mode);
      localStorage.setItem(accentKey, accent);
    } catch { /* The controls still work when browser storage is unavailable. */ }
  });
  system.addEventListener('change', () => { if (mode === 'system') apply(); });
  window.addEventListener('storage', event => {
    if (event.key === modeKey || event.key === null) mode = validMode(event.newValue);
    if (event.key === accentKey || event.key === null) accent = validAccent(event.newValue);
    if (event.key === modeKey || event.key === accentKey || event.key === null) apply();
  });
  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && picker.open) { picker.open = false; toggle.focus(); }
  });
  apply();
</script>
