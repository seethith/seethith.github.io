<aside class="mascot" aria-label="看板娘" transition:persist="mascot">
  <p class="mascot-bubble" role="status" hidden></p>
  <button class="mascot-close" type="button" aria-label="关闭看板娘" title="关闭看板娘，可在外观设置中重新开启">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M7 17 17 7" /></svg>
  </button>
  <button class="mascot-character" type="button" aria-label="和看板娘打个招呼" title="打个招呼">
    <img src="/images/mascot/assistant.webp" alt="" width="512" height="768" loading="lazy" decoding="async" draggable="false" />
  </button>
</aside>

<script>
  const mascot = document.querySelector<HTMLElement>('.mascot')!;
  const character = mascot.querySelector<HTMLButtonElement>('.mascot-character')!;
  const close = mascot.querySelector<HTMLButtonElement>('.mascot-close')!;
  const bubble = mascot.querySelector<HTMLParagraphElement>('.mascot-bubble')!;
  const greetings = ['你好呀。', '左边可以听歌 ♪', '慢慢逛。'];
  let greeting = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;

  function dismissBubble() {
    clearTimeout(timer);
    bubble.hidden = true;
    bubble.textContent = '';
    mascot.classList.remove('is-greeting');
  }
  character.addEventListener('click', () => {
    dismissBubble();
    bubble.textContent = greetings[greeting++ % greetings.length] ?? '你好呀。';
    bubble.hidden = false;
    mascot.classList.add('is-greeting');
    timer = setTimeout(dismissBubble, 3500);
  });
  close.addEventListener('click', () => {
    dismissBubble();
    window.dispatchEvent(new CustomEvent('mascotchange', { detail: false }));
    document.querySelector<HTMLElement>('.appearance-toggle')?.focus({ preventScroll: true });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') dismissBubble();
  });
  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Node && !mascot.contains(event.target)) dismissBubble();
  });
  document.addEventListener('astro:after-swap', dismissBubble);
  window.addEventListener('appearancechange', () => {
    if (document.documentElement.dataset.mascot !== 'on') dismissBubble();
  });
  const updateActivity = () => { mascot.dataset.paused = String(document.hidden); };
  document.addEventListener('visibilitychange', updateActivity);
  updateActivity();
</script>
