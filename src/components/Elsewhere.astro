---
import { collectedLinks } from '../data/site';
---
<section id="links" class="links-section" aria-labelledby="links-title">
  <div class="section-heading" data-reveal><h2 id="links-title">链接</h2><span class="section-caption mono" aria-hidden="true">ELSEWHERE / 03</span></div>
  <div class="links-grid">
    {collectedLinks.map((link, index) => <a class="directory-card" href={link.url} target="_blank" rel="noopener noreferrer" data-reveal data-delay={index * 70} data-surface>
      <span class="directory-icon" aria-hidden="true">{index === 0 ? <svg viewBox="0 0 24 24"><path d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.3 6-1.5 6-6a4.7 4.7 0 0 0-1-3.3A4.3 4.3 0 0 0 19 2s-1 0-3 1.5a12 12 0 0 0-7 0C7 2 6 2 6 2a4.3 4.3 0 0 0 0 3.7A4.7 4.7 0 0 0 5 9c0 4.5 3 5.7 6 6a3.5 3.5 0 0 0-1 3v4" /></svg> : <svg viewBox="0 0 24 24"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18" /></svg>}</span>
      <div class="directory-copy"><h3>{link.title}</h3><p>{link.description}</p></div>
      <span class="directory-status" aria-hidden="true">↗</span>
    </a>)}
  </div>
</section>
