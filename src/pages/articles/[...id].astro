---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getArticles, articleDate, articleUrl } from '../../lib/articles';
import { profile } from '../../data/site';
export async function getStaticPaths() {
  return (await getArticles()).map(article => ({ params: { id: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content } = await render(article);
---
<Layout title={`${article.data.title} · ${profile.name}`} description={article.data.description ?? article.data.title}>
  <article class="article-page">
    <a href="/articles/" class="lab-back">← 全部文章</a>
    <header class="article-header" data-article-url={articleUrl(article.id)}><time class="mono" datetime={articleDate(article.data.date)}>{articleDate(article.data.date)}</time><h1 data-article-title={articleUrl(article.id)}>{article.data.title}</h1>{article.data.description && <p>{article.data.description}</p>}</header>
    <div class="article-body"><Content /></div>
  </article>
</Layout>
