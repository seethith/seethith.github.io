---
import Layout from '../../layouts/Layout.astro';
import RippleField from '../../components/RippleField';
import { profile } from '../../data/site';
---
<Layout title={`像素潮汐 · ${profile.name}`} description="点击点阵，产生涟漪。">
  <section class="lab-page">
    <a href="/#playground" class="lab-back">← 小工具</a>
    <div class="lab-heading"><h1><span data-route-title="ripple">像素潮汐</span><span class="blue-period">.</span></h1></div>
    <div class="ripple-stage" data-route-surface="ripple-detail"><RippleField client:load expanded transition:persist="ripple-field" /></div>
  </section>
</Layout>
