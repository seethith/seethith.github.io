---
import '../styles/global.css';
import '../styles/refinement.css';
import '../styles/continuity.css';
import '../styles/art-direction.css';
import '../styles/stage.css';
import { profile } from '../data/site';
import Appearance from '../components/Appearance.astro';
import Atmosphere from '../components/Atmosphere.astro';
import { ClientRouter } from 'astro:transitions';
import MusicPlayer from '../components/MusicPlayer';
import { musicTracks } from '../data/music';
import Mascot from '../components/Mascot.astro';
interface Props { title?: string; description?: string }
const { title = `${profile.name} · 个人主页`, description = profile.intro } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-wallpaper="dusk" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe7" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff" as="font" type="font/woff" crossorigin />
    <ClientRouter fallback="swap" />
    <script is:inline>
      // Restore before first paint, including when returning from another page.
      (() => {
        let mode = 'system', accent = 'blue', wallpaper = 'dusk';
        let sakura = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        let mascot = true;
        try {
          const savedMode = localStorage.getItem('buluku-color-mode');
          const savedAccent = localStorage.getItem('buluku-accent');
          if (['light', 'dark', 'system'].includes(savedMode)) mode = savedMode;
          if (['blue', 'green', 'purple', 'pink'].includes(savedAccent)) accent = savedAccent;
          const savedWallpaper = localStorage.getItem('buluku-wallpaper');
          const savedSakura = localStorage.getItem('buluku-sakura');
          if (['dusk', 'ink', 'glow', 'none'].includes(savedWallpaper)) wallpaper = savedWallpaper;
          if (['on', 'off'].includes(savedSakura)) sakura = savedSakura === 'on';
          mascot = localStorage.getItem('buluku-mascot') !== 'off';
        } catch {}
        const theme = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
        document.documentElement.dataset.mode = mode;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.accent = accent;
        document.documentElement.dataset.wallpaper = wallpaper;
        document.documentElement.dataset.sakura = sakura ? 'on' : 'off';
        document.documentElement.dataset.mascot = mascot ? 'on' : 'off';
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#111827' : '#f5efe7';
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Atmosphere />
    <div class="page-atmosphere-wash" aria-hidden="true"></div>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="site-shell">
      <header class="site-header flex items-center justify-between" transition:name="site-header" transition:animate="none">
        <a href="/" class="brand" aria-label="buluku 首页"><span class="brand-mark">b<span>✦</span></span><span>{profile.name}<span class="brand-period">.</span></span></a>
        <div class="header-actions">
          <nav class="flex items-center gap-7" aria-label="主要导航">
            <a href="/#playground">小工具</a><a href="/#articles">文章</a><a href="/#links">链接</a>
          </nav>
          <Appearance />
        </div>
      </header>
      <main id="main" transition:name="page-content"><slot /></main>
      <footer class="site-footer flex flex-wrap items-center justify-between gap-4">
        <p>© 2026 {profile.name}</p>
        <a href="#main" class="back-top">回到顶部 <span aria-hidden="true">↑</span></a>
      </footer>
    </div>
    <MusicPlayer tracks={musicTracks} client:load transition:persist="music-player" />
    <Mascot />
    <script>
      import { initPageMotion, disposePageMotion } from '../scripts/page-motion';
      import '../scripts/route-continuity';
      initPageMotion();
      document.addEventListener('astro:page-load', initPageMotion);
      document.addEventListener('astro:before-swap', disposePageMotion);
    </script>
  </body>
</html>
