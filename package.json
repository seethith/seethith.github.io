{
  "name": "buluku-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && npm run build:v2 && npm run build:v3 && node scripts/merge-portfolios.mjs",
    "build:v2": "npm --prefix portfolio-v2 run build",
    "dev:v2": "npm --prefix portfolio-v2 run dev",
    "build:v3": "npm --prefix portfolio-v3 run build",
    "dev:v3": "npm --prefix portfolio-v3 run dev",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && npm --prefix portfolio-v2 run check && npm --prefix portfolio-v3 run check"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
